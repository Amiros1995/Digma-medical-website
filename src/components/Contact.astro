---
import siteData from '../data/site.json';
import { siteConfig } from '../config/site';

const { contact } = siteData;

const useFormspree = Boolean(siteConfig.formspreeId);
const formEndpoint = useFormspree
  ? `https://formspree.io/f/${siteConfig.formspreeId}`
  : `https://formsubmit.co/ajax/${encodeURIComponent(siteConfig.email)}`;
---

<section id="contact" class="gradient-hero relative overflow-hidden border-b border-line">
  <div class="ring-decoration -bottom-64 -left-40 hidden h-[560px] w-[560px] opacity-50 sm:block" aria-hidden="true">
    <span class="ring-decoration inset-0 border border-line"></span>
    <span class="ring-decoration inset-[100px] border border-ring"></span>
    <span class="ring-decoration inset-[200px] border border-[1.5px] border-primary"></span>
  </div>

  <div class="section-padding relative">
    <div class="container-wide grid gap-14 lg:grid-cols-2 lg:items-start">
      <div class="reveal">
        <div class="text-[11px] tracking-[0.22em] text-primary uppercase">{contact.title}</div>
        <h2 class="mt-5 font-display text-3xl font-bold leading-tight tracking-tight text-ink text-balance sm:text-4xl">
          Let's talk about the clinical program
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-body">{contact.subtitle}</p>

        <div class="mt-9 grid gap-3 border-t border-line pt-7">
          <div>
            <div class="text-[11px] tracking-[0.2em] text-faint uppercase">Email</div>
            <a href={`mailto:${siteConfig.email}`} class="mt-1.5 block text-[15px] text-primary hover:text-primary-light">
              {siteConfig.email}
            </a>
          </div>
          <div>
            <div class="text-[11px] tracking-[0.2em] text-faint uppercase">Phone</div>
            <a href={`tel:${siteConfig.phoneTel}`} class="mt-1.5 block text-[15px] text-primary hover:text-primary-light">
              {contact.phone}
            </a>
          </div>
        </div>

        <div class="mt-9 grid gap-5 sm:grid-cols-2">
          {
            contact.offices.map((office) => (
              <div class="border border-line bg-panel p-5">
                <div class="text-[11px] tracking-[0.2em] text-faint uppercase">{office.title}</div>
                <address class="mt-2 not-italic text-[14px] leading-relaxed text-emphasis">
                  {office.addressLines.map((line) => (
                    <span class="block">{line}</span>
                  ))}
                </address>
                <div class="mt-4 overflow-hidden border border-line">
                  <iframe
                    src={office.mapEmbedUrl}
                    class="aspect-[4/3] w-full"
                    style="border:0;filter:grayscale(0.15) invert(0.92) contrast(0.9);"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title={`${office.title} on Google Maps`}
                  />
                </div>
                <a
                  href={office.mapLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex items-center gap-1.5 text-[13px] text-primary hover:text-primary-light"
                >
                  Open in Google Maps
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            ))
          }
        </div>
      </div>

      <form
        id="contact-form"
        class="reveal reveal-delay-1 grid gap-5 border border-line-strong bg-panel p-8"
        data-endpoint={formEndpoint}
        data-success-message={contact.successMessage}
        data-error-message={contact.errorMessage}
        data-sending-label={contact.sendingLabel}
        novalidate
      >
        <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

        {
          !useFormspree && (
            <>
              <input type="hidden" name="_subject" value="New inquiry from digmamedical.com" />
              <input type="hidden" name="_template" value="table" />
              <input type="hidden" name="_captcha" value="false" />
            </>
          )
        }

        <label class="grid gap-2">
          <span class="text-xs tracking-[0.14em] text-faint uppercase">{contact.fields.name}</span>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            class="border border-line-strong bg-surface px-4 py-3 text-[15px] text-ink transition focus:border-primary focus:outline-none"
          />
        </label>
        <label class="grid gap-2">
          <span class="text-xs tracking-[0.14em] text-faint uppercase">{contact.fields.email}</span>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="border border-line-strong bg-surface px-4 py-3 text-[15px] text-ink transition focus:border-primary focus:outline-none"
          />
        </label>
        <label class="grid gap-2">
          <span class="text-xs tracking-[0.14em] text-faint uppercase">{contact.fields.subject}</span>
          <input
            type="text"
            id="subject"
            name="subject"
            required
            class="border border-line-strong bg-surface px-4 py-3 text-[15px] text-ink transition focus:border-primary focus:outline-none"
          />
        </label>
        <label class="grid gap-2">
          <span class="text-xs tracking-[0.14em] text-faint uppercase">{contact.fields.message}</span>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="resize-y border border-line-strong bg-surface px-4 py-3 text-[15px] text-ink transition focus:border-primary focus:outline-none"
          ></textarea>
        </label>

        <button
          type="submit"
          class="mt-1.5 rounded-sm bg-primary py-3.5 text-sm font-bold tracking-wide text-panel-strong transition hover:bg-primary-light disabled:cursor-not-allowed disabled:opacity-60"
        >
          {contact.submitLabel}
        </button>

        <p id="contact-form-status" class="hidden min-h-[1.25rem] text-center text-sm" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script src="../scripts/contact-form.ts"></script>
