---
import siteData from '../data/site.json';
import { siteConfig, footerLinks } from '../config/site';

const hqOffice = siteData.contact.offices[0];
const addressLine = hqOffice ? hqOffice.addressLines.join(', ') : '';
---

<footer class="border-t border-line bg-panel-strong">
  <div class="section-padding !py-14">
    <div class="container-wide grid gap-10 md:grid-cols-2 lg:grid-cols-3">
      <div>
        <div class="flex flex-col leading-none">
          <span class="font-display text-lg font-bold tracking-[0.14em] text-ink">
            VERI<span class="text-primary">DEPTH</span>
          </span>
          <span class="mt-1.5 text-[9.5px] tracking-[0.22em] text-faint">A PRODUCT OF DIGMA MEDICAL</span>
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-faint">
          Depth-controlled endoscopic LASER ablation for gastrointestinal disease, starting with Barrett's esophagus.
        </p>
      </div>

      <div>
        <h2 class="mb-3 text-sm font-semibold tracking-wider text-faint uppercase">Explore</h2>
        <nav class="grid gap-2.5">
          {
            footerLinks.map((link) => (
              <a href={link.href} class="text-sm text-body transition hover:text-ink">
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <div>
        <h2 class="mb-3 text-sm font-semibold tracking-wider text-faint uppercase">Contact</h2>
        <a href={`mailto:${siteConfig.email}`} class="block text-sm text-body transition hover:text-ink">
          {siteConfig.email}
        </a>
        <a href={`tel:${siteConfig.phoneTel}`} class="mt-2 block text-sm text-body transition hover:text-ink">
          {siteConfig.phone}
        </a>
        <p class="mt-3 text-sm leading-relaxed text-faint">{addressLine}</p>
        <div class="mt-4">
          <a
            href={siteConfig.linkedIn}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm text-body transition hover:text-ink"
          >
            LinkedIn
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

    <div class="container-wide mt-10 grid gap-2.5 border-t border-line pt-6">
      <p class="max-w-3xl text-[12.5px] leading-relaxed text-faint">{siteConfig.iuoDisclaimer}</p>
      <p class="max-w-3xl text-[12.5px] leading-relaxed text-faint">
        Quality management system certified to ISO 13485:2016 by the Standards Institution of Israel (SII), Certificate
        No. 114182.
        <a
          href={`${import.meta.env.BASE_URL}documents/iso-13485-certificate-114182.pdf`}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-1 text-faint underline-offset-2 hover:text-body hover:underline"
        >
          View certificate
        </a>
      </p>
      <p class="mt-1 text-[12.5px] text-faintest">© {siteConfig.copyrightYear} {siteConfig.name}, Ltd. All rights reserved.</p>
    </div>
  </div>
</footer>
