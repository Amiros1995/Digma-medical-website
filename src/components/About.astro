---
import siteData from '../data/site.json';

const { about } = siteData;
---

<section id="about" class="section-padding border-b border-line bg-surface">
  <div class="container-narrow">
    <div class="reveal mx-auto max-w-3xl text-center">
      <div class="text-[11px] tracking-[0.22em] text-primary uppercase">{about.eyebrow}</div>
      <h2 class="mt-5 font-display text-3xl font-bold tracking-tight text-ink text-balance sm:text-4xl">
        {about.title}
      </h2>
    </div>

    <div class="reveal mt-12 grid gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="space-y-5 text-base leading-relaxed text-body">
        {about.paragraphs.slice(0, 2).map((p) => <p>{p}</p>)}
      </div>
      <div class="space-y-5 text-base leading-relaxed text-body">
        {about.paragraphs.slice(2).map((p) => <p>{p}</p>)}
        <p class="border border-line-strong bg-panel p-5 text-base leading-relaxed text-emphasis">
          {about.clinicalCta}
          <a href="#contact" class="ml-1 text-primary hover:text-primary-light">Contact us →</a>
        </p>
      </div>
    </div>
  </div>
</section>
