---
import teamData from '../data/team.json';
import siteData from '../data/site.json';

const { team } = siteData;
const base = import.meta.env.BASE_URL;
---

<section id="team" class="section-padding border-b border-line bg-surface">
  <div class="container-wide">
    <div class="reveal text-[11px] tracking-[0.22em] text-primary uppercase">{team.title}</div>
    <h2 class="reveal mt-5 max-w-3xl font-display text-3xl font-bold leading-tight tracking-tight text-ink text-balance sm:text-4xl">
      {team.subtitle}
    </h2>

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        teamData.members.map((member, i) => (
          <article class:list={['reveal border border-line bg-panel p-7', i > 0 ? `reveal-delay-${Math.min(i % 3, 3)}` : '']}>
            {
              member.image ? (
                <img
                  src={`${base}${member.image.replace(/^\//, '')}`}
                  alt={`Portrait of ${member.name}`}
                  class:list={[
                    'h-[76px] w-[76px] rounded-full border border-ring object-cover object-top',
                    member.imageFit === 'contain' ? 'bg-surface object-contain p-1' : '',
                  ]}
                  loading="lazy"
                  width="76"
                  height="76"
                />
              ) : (
                <div
                  class="flex h-[76px] w-[76px] items-center justify-center rounded-full border border-ring bg-surface-alt font-display text-lg font-bold text-primary"
                  aria-hidden="true"
                >
                  {member.initials}
                </div>
              )
            }
            <h3 class="mt-4 text-[17px] font-bold text-ink">{member.name}</h3>
            <p class="mt-1 text-[13px] tracking-wide text-primary uppercase">{member.role}</p>
            <p class="mt-3 text-sm leading-relaxed text-soft">{member.bio}</p>
          </article>
        ))
      }

      {
        teamData.clinicalAdvisors?.length > 0 && (
          <div class="reveal border border-line bg-surface p-7">
            <div class="text-[11px] tracking-[0.22em] text-faint uppercase">{teamData.clinicalAdvisorsTitle}</div>
            <div class="mt-5 grid gap-3.5">
              {teamData.clinicalAdvisors.map((advisor) => (
                <div class="border-t border-line pt-3">
                  <div class="text-[15px] text-ink">{advisor.name}</div>
                  <div class="mt-0.5 text-[13.5px] text-soft">{advisor.affiliation}</div>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
