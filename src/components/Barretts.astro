---
import siteData from '../data/site.json';

const { barretts } = siteData;
const base = import.meta.env.BASE_URL;
const imageSrc = barretts.image ? `${base}${barretts.image.replace(/^\//, '')}` : null;
---

<section id="barretts" class="section-padding border-b border-line bg-surface">
  <div class="container-wide">
    <div class="reveal text-[11px] tracking-[0.22em] text-primary uppercase">{barretts.eyebrow}</div>
    <div class="mt-5 grid gap-14 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      {
        imageSrc && (
          <figure class="reveal">
            <img
              src={imageSrc}
              alt={barretts.imageAlt}
              class="w-full border border-line object-contain bg-panel p-3"
              loading="lazy"
              width="640"
              height="480"
            />
            <figcaption class="mt-3 text-[12.5px] leading-relaxed text-faint">{barretts.imageCaption}</figcaption>
          </figure>
        )
      }
      <div class="reveal reveal-delay-1">
        <h2 class="font-display text-3xl font-bold leading-tight tracking-tight text-ink text-balance sm:text-4xl">
          {barretts.title}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-body">{barretts.description}</p>
        <div class="mt-7 grid gap-3">
          {
            barretts.points.map((point, i) => (
              <div class="flex gap-4 border-t border-line pt-3">
                <span class="text-[13px] text-primary">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-[15px] leading-relaxed text-emphasis">{point}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
