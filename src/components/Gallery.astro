---
import galleryData from '../data/gallery.json';

if (!galleryData.enabled || galleryData.photos.length === 0) {
  return null;
}

const base = import.meta.env.BASE_URL;
---

<section id="gallery" class="section-padding border-b border-line bg-surface-alt">
  <div class="container-wide">
    <div class="reveal mx-auto max-w-3xl text-center">
      <h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">{galleryData.title}</h2>
      {galleryData.subtitle && <p class="mt-4 text-lg text-body">{galleryData.subtitle}</p>}
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        galleryData.photos.map((photo, i) => (
          <figure class:list={['reveal overflow-hidden border border-line bg-panel', i > 0 ? `reveal-delay-${Math.min(i % 3, 2)}` : '']}>
            <img
              src={`${base}${photo.src.replace(/^\//, '')}`}
              alt={photo.alt}
              class="aspect-[4/3] w-full object-cover"
              loading="lazy"
              width="640"
              height="480"
            />
            {photo.caption && <figcaption class="px-4 py-3 text-sm text-soft">{photo.caption}</figcaption>}
          </figure>
        ))
      }
    </div>
  </div>
</section>
