---
import siteData from '../data/site.json';

const { platform } = siteData;
const base = import.meta.env.BASE_URL;
const consoleSrc = platform.image ? `${base}${platform.image.replace(/^\//, '')}` : null;
const catheterSrc = platform.secondaryImage ? `${base}${platform.secondaryImage.replace(/^\//, '')}` : null;
const ablationSrc = platform.ablationVideo ? `${base}${platform.ablationVideo.replace(/^\//, '')}` : null;

const icons = [
  'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z',
  'M13 10V3L4 14h7v7l9-11h-7z',
  'M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5',
  'M15 12a3 3 0 11-6 0 3 3 0 016 0zM21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  'M13 10V3L4 14h7v7l9-11h-7z',
  'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5',
];
---

<section id="platform" class="section-padding border-b border-line bg-surface-alt">
  <div class="container-wide">
    <div class="reveal flex flex-wrap items-end justify-between gap-8">
      <div class="max-w-2xl">
        <div class="text-[11px] tracking-[0.22em] text-primary uppercase">{platform.eyebrow}</div>
        <h2 class="mt-5 font-display text-3xl font-bold leading-tight tracking-tight text-ink text-balance sm:text-4xl">
          {platform.title}
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-body">{platform.subtitle}</p>
      </div>
      <div class="border border-ring px-5 py-3.5">
        <div class="text-[10.5px] tracking-[0.2em] text-faint uppercase">{platform.tagLabel}</div>
        <div class="mt-1.5 text-[15px] text-ink">{platform.tagDetail}</div>
      </div>
    </div>

    {
      (consoleSrc || catheterSrc) && (
        <div class="reveal mt-12 grid gap-5 sm:grid-cols-2">
          {consoleSrc && (
            <figure class="border border-line bg-surface p-6">
              <img
                src={consoleSrc}
                alt={platform.imageAlt}
                class="mx-auto h-72 w-full object-contain"
                loading="lazy"
                width="800"
                height="600"
              />
              <div class="mt-4 text-[12px] tracking-[0.12em] text-faint uppercase">{platform.imageCaption}</div>
            </figure>
          )}
          {catheterSrc && (
            <figure class="border border-line bg-surface p-6">
              <img
                src={catheterSrc}
                alt={platform.secondaryImageAlt}
                class="mx-auto h-72 w-full object-contain"
                loading="lazy"
                width="800"
                height="600"
              />
              <div class="mt-4 text-[12px] tracking-[0.12em] text-faint uppercase">{platform.secondaryImageCaption}</div>
            </figure>
          )}
        </div>
      )
    }

    <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        platform.features.map((feature, i) => (
          <article class:list={['reveal border border-line bg-surface p-7 transition hover:border-primary/40', i > 0 ? `reveal-delay-${Math.min(i, 3)}` : '']}>
            <div class="flex h-9 w-9 items-center justify-center text-primary">
              <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icons[i % icons.length]}></path>
              </svg>
            </div>
            <h3 class="mt-4 text-[17px] font-bold text-ink">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-soft">{feature.description}</p>
          </article>
        ))
      }
    </div>

    {
      ablationSrc && (
        <div class="reveal mt-5 grid gap-8 border border-line bg-surface p-7 lg:grid-cols-2 lg:items-center lg:p-9">
          <video
            class="ablation-video w-full border border-line bg-black"
            autoplay
            loop
            muted
            playsinline
            preload="auto"
            aria-label={platform.ablationVideoAlt}
          >
            <source src={ablationSrc} type="video/mp4" />
          </video>
          <div>
            <div class="text-[11px] tracking-[0.22em] text-primary uppercase">{platform.mapMark.eyebrow}</div>
            <div class="mt-3 text-xl font-bold leading-snug text-ink sm:text-2xl">{platform.mapMark.title}</div>
            <p class="mt-3 text-[15px] leading-relaxed text-soft">{platform.mapMark.description}</p>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .ablation-video {
      display: none;
    }
  }
</style>
