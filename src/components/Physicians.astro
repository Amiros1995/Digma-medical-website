---
import siteData from '../data/site.json';

const { physicians } = siteData;
---

<section id="physicians" class="section-padding border-b border-line bg-surface-alt">
  <div class="container-wide">
    <div class="reveal text-[11px] tracking-[0.22em] text-primary uppercase">{physicians.eyebrow}</div>
    <div class="mt-5 grid gap-14 lg:grid-cols-[1fr_1.2fr] lg:items-start">
      <div class="reveal">
        <h2 class="font-display text-3xl font-bold leading-tight tracking-tight text-ink text-balance sm:text-4xl">
          {physicians.title}
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-body">{physicians.description}</p>
      </div>
      <div class="grid gap-4">
        {
          physicians.points.map((point, i) => (
            <div class:list={['reveal flex gap-5 border border-line bg-surface p-6', i > 0 ? `reveal-delay-${Math.min(i, 3)}` : '']}>
              <span class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-primary/40 text-primary">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </span>
              <div>
                <div class="text-base font-bold text-ink">{point.title}</div>
                <div class="mt-1.5 text-sm leading-relaxed text-soft">{point.description}</div>
              </div>
            </div>
          ))
        }
        <p class="text-xs leading-relaxed text-faint">{physicians.disclaimer}</p>
      </div>
    </div>
  </div>
</section>
