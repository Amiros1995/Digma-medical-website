---
import siteData from '../data/site.json';

const { stats } = siteData;

const accentClass: Record<string, string> = {
  primary: 'text-primary',
  accent: 'text-accent',
};
---

<section class="border-b border-line bg-surface-alt">
  <div class="container-wide grid grid-cols-1 divide-y divide-line sm:grid-cols-2 sm:divide-y-0 sm:divide-x lg:grid-cols-4">
    {
      stats.items.map((stat, i) => (
        <div class:list={['reveal px-6 py-9 sm:px-7', i > 0 ? `reveal-delay-${Math.min(i, 3)}` : '']}>
          <div class:list={['font-display text-3xl font-bold sm:text-4xl', accentClass[stat.accent as string] || 'text-ink']}>
            {stat.value}
          </div>
          <div class="mt-2 text-[13px] leading-relaxed text-soft">{stat.label}</div>
        </div>
      ))
    }
  </div>
</section>
