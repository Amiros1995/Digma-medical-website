---
import siteData from '../data/site.json';

const { quality } = siteData;
const base = import.meta.env.BASE_URL;
const certificateUrl = `${base}${quality.certificatePath.replace(/^\//, '')}`;
---

<section id="quality" class="section-padding border-b border-line bg-surface-alt">
  <div class="container-narrow grid gap-14 lg:grid-cols-2 lg:items-start">
    <div class="reveal">
      <div class="text-[11px] tracking-[0.22em] text-primary uppercase">{quality.title}</div>
      <h2 class="mt-5 font-display text-[26px] font-bold leading-tight text-ink text-balance sm:text-3xl">
        {quality.subtitle}
      </h2>
      <p class="mt-5 text-[15.5px] leading-relaxed text-body">{quality.intro}</p>

      <div class="mt-7">
        <h3 class="text-xs font-semibold tracking-wider text-faint uppercase">{quality.scopeLabel}</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-body">{quality.scope}</p>
      </div>
    </div>

    <div class="reveal reveal-delay-1 border border-line-strong bg-surface p-7">
      <div class="grid gap-0">
        {
          quality.details.map((item, i) => (
            <div class:list={['flex justify-between py-3', i < quality.details.length - 1 ? 'border-b border-line' : '']}>
              <span class="text-[13.5px] text-faint">{item.label}</span>
              <span class="text-[13.5px] text-ink">{item.value}</span>
            </div>
          ))
        }
      </div>
      <a
        href={certificateUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-2 rounded-sm bg-primary px-5 py-3 text-sm font-semibold text-panel-strong transition hover:bg-primary-light"
      >
        {quality.certificateLabel}
        <span aria-hidden="true">↗</span>
      </a>
      <p class="mt-6 text-[12.5px] leading-relaxed text-faint">{quality.disclaimer}</p>
    </div>
  </div>
</section>
