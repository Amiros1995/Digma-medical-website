---
import { navLinks } from '../config/site';

const base = import.meta.env.BASE_URL;
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-surface/90 backdrop-blur-md transition-all duration-300"
>
  <div class="container-wide flex h-[4.5rem] items-center justify-between gap-6 px-5 md:h-20 md:px-8">
    <a href={base} class="group flex shrink-0 items-center gap-3" aria-label="VeriDepth by Digma Medical home">
      <span class="flex h-8 w-8 items-center justify-center rounded-full border border-primary/70 transition group-hover:border-primary">
        <span class="block h-2 w-2 rounded-full bg-primary"></span>
      </span>
      <span class="flex flex-col leading-none">
        <span class="font-display text-lg font-bold tracking-[0.14em] text-ink sm:text-xl">
          VERI<span class="text-primary">DEPTH</span>
        </span>
        <span class="mt-1 text-[9.5px] tracking-[0.22em] text-faint">A PRODUCT OF DIGMA MEDICAL</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-3 py-2 text-sm tracking-wide text-body transition hover:text-ink"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block">
      <a
        href="#contact"
        class="inline-flex items-center rounded-sm border border-primary px-5 py-2.5 text-sm font-semibold tracking-wide text-primary transition hover:bg-primary hover:text-panel-strong"
      >
        Contact
      </a>
    </div>

    <button
      id="mobile-menu-btn"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-line-strong bg-panel text-ink lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg id="menu-icon-open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="menu-icon-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-line bg-surface/98 backdrop-blur-md lg:hidden"
    aria-label="Mobile navigation"
  >
    <nav class="container-wide flex flex-col gap-1 px-5 py-4">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link rounded-lg px-4 py-3 text-base font-medium text-body transition hover:bg-panel hover:text-ink"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="#contact"
        class="mobile-nav-link mt-2 rounded-sm border border-primary px-4 py-3 text-center text-base font-semibold text-primary"
      >
        Contact
      </a>
    </nav>
  </div>
</header>

<div class="h-[4.5rem] md:h-20" aria-hidden="true"></div>
